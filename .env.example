# Required private login. Generate a long random token; never commit real values.
APP_PASSWORD=
APP_AUTH_TOKEN=

# Required for live Angel One data; server-side only.
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP_SECRET=

# Optional, server-side read-only comparison. Never prefix with NEXT_PUBLIC_.
# Create in Upstox Developer Apps > Analytics. Store as a Production Secret in Vercel.
UPSTOX_ANALYTICS_TOKEN=

# Optional headline sentiment, not a price feed.
HUGGINGFACE_API_KEY=

# Optional discipline coach.
OPENAI_API_KEY=

# Required shared Angel request counter (Upstash Redis REST, server-side only).
# Vercel's Upstash integration may supply KV_REST_API_URL / KV_REST_API_TOKEN instead.
# Use the SAME database for every deployment/local server using this Angel account.
# Leave these blank when using integration-provided variables. Never use NEXT_PUBLIC_.
ANGEL_RATE_REDIS_REST_URL=
ANGEL_RATE_REDIS_REST_TOKEN=
